# Optional: defaults to ./data/olyvara.sqlite for local development.
OLYVARA_DATABASE_PATH=./data/olyvara.sqlite

# Demo records are enabled automatically outside production. Set false to disable.
SEED_DEMO=true

# Google OAuth web client. Register this exact callback URL with Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Apple Sign In. Use an Apple Service ID as the client ID and a Sign In with Apple key.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=http://localhost:3000/api/auth/apple/callback

# Set to the public origin when running behind a proxy or hosted preview.
APP_BASE_URL=http://localhost:3000